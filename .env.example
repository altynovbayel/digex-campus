# Скопируйте в .env.local и заполните значениями СВОЕГО отдельного проекта Supabase.
# .env.local не попадает в Git (см. .gitignore). Здесь значения намеренно пустые.

# Project Settings → Data API → Project URL (вида https://<ref>.supabase.co)
VITE_SUPABASE_URL=

# Project Settings → API Keys → Publishable key (начинается с sb_publishable_).
# Только publishable-ключ! Secret / service_role ключ в браузерный код не добавлять.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Демо-режим с вымышленным учеником. Работает ТОЛЬКО в `npm run dev`,
# в production-сборке игнорируется. В обычной работе — false.
VITE_DEMO_MODE=false
